# Copy to .env.local and fill in. Never commit real keys.
#
# --- Supabase (browser + SSR) ---
# Dashboard → Project Settings → API / Connect
# Local + `dev` branch: use your dev (or current) project.
# Production Pages build: set the same names as GitHub Actions secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias still accepted by src/lib/supabase helpers:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never put this in NEXT_PUBLIC_* or commit it)
# SUPABASE_SERVICE_ROLE_KEY=
# Local demo API / CLI also accepts SUPABASE_SECRET_KEY as an alias.
# Local CLI /api/v1/ingest owner (must be an auth.users UUID in the project):
# INGEST_OWNER_USER_ID=
#
# Optional local VC demo auth overrides (defaults work for local Supabase):
# POLICYWELL_DEMO_EMAIL=demo@policywell.local
# POLICYWELL_DEMO_PASSWORD=policywell-demo-local-2026
# POLICYWELL_API_URL=http://localhost:3000/api/v1

# Optional LLM phrasing for /api/agent (dev / non-static hosts only).
# GitHub Pages is a static export - the browser agent still works without any key.
#
# Good free / high-limit options for a white-label chat backend:
#   1) Google AI Studio (Gemini Flash) - already wired below
#      https://aistudio.google.com/apikey
#   2) GitHub Models - free with a GitHub PAT (models:read)
#      https://github.com/marketplace/models
#      Endpoint: https://models.github.ai/inference  (OpenAI-compatible)
#   3) Groq - very fast free tier (no card)
#      https://console.groq.com/keys
#   4) OpenRouter :free models - broad catalog, lower daily caps
#      https://openrouter.ai/keys
#
# For white-label on policywell.ai (static Pages), keep keys on a tiny
# backend (Cloudflare Worker / Vercel / Fly) - never ship them to the browser.

GOOGLE_GENERATIVE_AI_API_KEY=

# Optional alternatives if you extend llm.ts:
# GITHUB_MODELS_TOKEN=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# --- Universal access (docs + all private product surfaces) ---
# Preferred ops backdoor. GitHub Actions secret: UNIVERSAL_ACCESS_CODE
# Hashed into NEXT_PUBLIC_UNIVERSAL_ACCESS_CODE_HASH at build (plaintext not shipped).
UNIVERSAL_ACCESS_CODE=
# NEXT_PUBLIC_UNIVERSAL_ACCESS_CODE=
# NEXT_PUBLIC_UNIVERSAL_ACCESS_CODE_HASH=

# --- Private docs (always gated) ---
# Local: set either variable so /docs unlocks with your code.
# DOCS_ACCESS_CODE is preferred (not embedded in the client for `npm run build:pages`).
# NEXT_PUBLIC_DOCS_ACCESS_CODE is a local-dev convenience (plaintext in the client).
# GitHub Pages: DOCS_ACCESS_CODE and/or UNIVERSAL_ACCESS_CODE required for build.
DOCS_ACCESS_CODE=
NEXT_PUBLIC_DOCS_ACCESS_CODE=
# Advanced: precomputed SHA-256 hex (build-pages sets this automatically).
# NEXT_PUBLIC_DOCS_ACCESS_CODE_HASH=

# --- Private product surfaces (demo, product, deck, agent, platform, api) ---
# Prefer emailed one-time codes via Supabase Edge Functions + Resend
# (see docs/architecture/email-auth-access.md). Optional static ops backdoor:
# PRODUCT_ACCESS_CODE=
# NEXT_PUBLIC_PRODUCT_ACCESS_CODE=
# Optional Formspree fallback if Edge Functions are unavailable:
# NEXT_PUBLIC_ACCESS_REQUEST_WEBHOOK=https://formspree.io/f/xxxx
#
# Edge Function secrets (set in Supabase Dashboard, not NEXT_PUBLIC_):
#   RESEND_API_KEY=
#   EMAIL_FROM=PolicyWell <access@policywell.ai>
#   ACCESS_NOTIFY_EMAIL=info@policywell.ai
#   UNIVERSAL_ACCESS_CODE=   # same ops code; accepted by verify-access-code

# --- Pear X 27 live agent (/pear) ---
# Default unlock code is PEARX27 (hashed in client). Optional overrides:
# NEXT_PUBLIC_PEAR_ACCESS_CODE=PEARX27
# NEXT_PUBLIC_PEAR_ACCESS_CODE_HASH=
